# App
DEMO_MODE=true
RISING_THRESHOLD=20
CONFIDENCE_THRESHOLD=0.75
CLUSTER_SIMILARITY=0.86
VITE_WHATSAPP_NUMBER=         # the linked demo phone, digits only, e.g. 256700000000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (Supabase > Project Settings > Database > Connection string, session pooler)
SUPABASE_DB_URL=
# Email that becomes the demo journalist on first magic-link sign-in (`npm run demo:reset` invites it)
DEMO_JOURNALIST_EMAIL=

# Privacy (`npm run keys:generate` prints fresh values)
PHONE_HASH_SECRET=
REPLY_ADDRESS_KEY=            # 32 bytes, base64
# Optional: secret for function-to-function calls; derived from PHONE_HASH_SECRET when empty
INTERNAL_FUNCTION_SECRET=

# WhatsApp through Green API (console.green-api.com)
GREENAPI_URL=                 # apiUrl shown on your instance, e.g. https://7103.api.greenapi.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN_INSTANCE=
GREENAPI_WEBHOOK_TOKEN=       # random string; also set as webhookUrlToken in the console

# AI and search (zero-budget defaults)
LLM_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b   # pick from Groq's current model list
GOOGLE_VISION_API_KEY=
SUNBIRD_USERNAME=
SUNBIRD_PASSWORD=
SUNBIRD_API_TOKEN=            # optional: a long-lived token from the Sunbird dashboard instead of username/password
GOOGLE_FACTCHECK_API_KEY=
BRAVE_SEARCH_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_FROM_NAME=Sherlock
